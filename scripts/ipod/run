#!/bin/sh
#MISE description="Boot retailOS natively on Linux (or inside Docker); flags: README.md"
set -eu
cd "${MISE_PROJECT_ROOT:-$(dirname "$0")/../..}"
HEADLESS=
n=$#
while [ "$n" -gt 0 ]; do
  a=$1; shift; n=$((n - 1))
  case $a in
    --headless) HEADLESS=1 ;;
    --osos=*|osos=*) OSOS=${a#*osos=} ;;
    --disks=*|disks=*) DISK=${a#*disks=} ;;
    --firmware=*|firmware=*) FIRMWARE=${a#*firmware=} ;;
    --timeout=*) T=${a#--timeout=} ;;
    *) set -- "$@" "$a" ;;
  esac
done
[ -f "${OSOS:-}" ] || { echo "run: OSOS '${OSOS:-}' is not a file (pass --osos=PATH)" >&2; exit 1; }
[ -n "${DISK:-}" ] || { echo "run: no disk (pass --disks=PATH)" >&2; exit 1; }
if [ ! -e "$DISK" ]; then
  [ -n "${FIRMWARE:-}" ] || { echo "run: $DISK does not exist (pass --firmware=PATH)" >&2; exit 1; }
  mise run ipod:make-disk -- --firmware="$FIRMWARE" --disks="$DISK"
fi
BUILD_DIR=${BUILD_DIR:-build/native}
[ -x "$BUILD_DIR/qemu-system-arm" ] || { echo "run: no $BUILD_DIR/qemu-system-arm; run mise run build" >&2; exit 1; }
: "${T:=0}"
: "${SCRATCH:=assets/scratch}"
mkdir -p "$SCRATCH"
if [ -n "$HEADLESS" ]; then
  set -- -display none -audio driver=none "$@"
else
  : "${FWGUID:=000A270021574219}"
  : "${IRAMSPILL:=0x10000}"
  export FWGUID IRAMSPILL
  driver=none
  if [ "${AUDIO:-1}" != 0 ]; then
    driver=pa
    export AUDIOLIVE=1
  fi
  if [ -n "${DRYRUN:-}" ]; then
    echo "run: DRYRUN (native window)"
    exit 0
  fi
  md5sum "$OSOS" | tee "$SCRATCH/live.osos"
  rm -f "$SCRATCH/live.sock"
  set -- -display sdl -audio "driver=$driver" \
    -monitor "unix:$SCRATCH/live.sock,server,nowait" -gdb tcp::1405 "$@"
fi
if [ -n "${DRYRUN:-}" ]; then echo "run: DRYRUN (headless)"; exit 0; fi
case $DISK in *.qcow2) fmt=qcow2 ;; *) fmt=raw ;; esac
rc=0
timeout "$T" "$BUILD_DIR/qemu-system-arm" -M iPod-Classic -kernel "$OSOS" -serial null \
  -drive "if=ide,format=$fmt,file=$DISK" -snapshot -L "$BUILD_DIR/pc-bios" "$@" || rc=$?
[ "$rc" = 124 ] && rc=0
exit "$rc"
