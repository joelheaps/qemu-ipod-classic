#!/bin/sh
#MISE description="Run ruff (strict, inline config) and ty on the fork's Python (tools/ipod_classic)"
#
# Host-side via uvx.
# Extra args go to ruff check, e.g. `mise run check:python -- --fix`.
set -eu
cd "${MISE_PROJECT_ROOT:-$PWD}"
# Strict config, inline so the check needs no config file: every rule on, minus the few that
# conflict with the formatter, clash with each other, or don't fit standalone CLI scripts.
uvx ruff format --line-length 100 --target-version py312 tools/ipod_classic
uvx ruff check --config 'line-length = 100' --target-version py312 --select ALL \
  --ignore COM812,ISC001,D203,D213,T201,CPY001,INP001 \
  --per-file-ignores 'test_*.py:S101' --per-file-ignores 'test_*.py:PT009' \
  --per-file-ignores 'test_*.py:PT027' "$@" tools/ipod_classic
# Docker adapters are small standalone scripts; check their imports and basic Python rules too.
uvx ruff check scripts/docker/*.py scripts/docker/ipod/run scripts/ipod/make-disk
# ty needs the scripts' imports installed; they declare them in PEP 723 headers.
deps=$(mktemp -d)
trap 'rm -rf "$deps"' EXIT
uv pip install -q --target "$deps" -r tools/ipod_classic/emcore_s5l8702.py -r tools/ipod_classic/tests/test_emcore_s5l8702.py \
  -r tools/ipod_classic/tests/test_make_disk.py
uvx ty check --extra-search-path "$deps" --extra-search-path tools/ipod_classic tools/ipod_classic
