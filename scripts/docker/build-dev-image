#!/bin/sh
#MISE description="Build the dev image qemu-ipod-dev (runs/debugs guests; no compilers)"
#
# No-op when the image already matches the Dockerfile: the build's Dockerfile hash is
# stored as a label, so an unchanged Dockerfile skips docker build entirely. (docker
# build re-resolves the mutable base/uv tags and can still take ~50s when "cached".)
set -eu
cd "${MISE_PROJECT_ROOT:-$PWD}"
img=qemu-ipod-dev
df=docker/Dockerfile.dev
hash=$(sha256sum "$df" | cut -d' ' -f1)
have=$(docker image inspect -f '{{index .Config.Labels "mise.dockerfile"}}' "$img" 2>/dev/null || true)
if [ "$have" = "$hash" ]; then
  echo "$img is up to date ($df unchanged)"
  exit 0
fi
docker build --label "mise.dockerfile=$hash" -t "$img" -f "$df" docker
