#!/bin/sh
#MISE description="Configure (first time) and build qemu-system-arm into build/ (needs docker:build-images)"
#MISE depends=["docker:build-images"]
#MISE sources=["hw/**/*", "include/**/*", "plugins/**/*", "contrib/plugins/**/*", "ui/**/*", "configs/**/*", "configure", "meson.build"]
#MISE outputs=["build/qemu-system-arm", "build/qemu-img", "build/contrib/plugins/libpctrace.so", "build/contrib/plugins/libprovtrace.so"]
#
# sources = the dirs the fork edits (never a root `**`: it would walk build/ and
# assets/); mise skips the task when the outputs are newer, before the container
# re-exec. ninja leaves an unchanged binary alone, so the outputs are stamped with
# the build's start time (an edit made mid-build stays newer).
#
# QEMU builds in the build image (docker/Dockerfile.build); re-exec the task
# there. The dev image has no compilers, so it can't build.
if [ "${EMULATOR_BUILD_IN_CONTAINER:-0}" != 1 ]; then
  root=${MISE_PROJECT_ROOT:-$PWD}
  exec docker run --rm -i --user "$(id -u):$(id -g)" -v "$root:$root" -w "$root" qemu-ipod-build \
    env EMULATOR_BUILD_IN_CONTAINER=1 "${MISE_TASK_FILE:-$0}" "$@"
fi
set -eu
cd "${MISE_PROJECT_ROOT:-$PWD}"
mkdir -p build && cd build
{ [ -f build.ninja ] || ../configure --enable-sdl --disable-cocoa \
  --target-list=arm-softmmu --disable-capstone --disable-slirp --extra-cflags=-I/usr/include/openssl \
  --extra-ldflags=-lcrypto --disable-werror --enable-pie; }
start=$(date +%s)
ninja qemu-system-arm qemu-img
# TCG pctrace plugin (contrib Makefile is configure-generated; needs the container's glib)
make -C contrib/plugins libpctrace.so libprovtrace.so
touch -d "@$start" qemu-system-arm qemu-img contrib/plugins/libpctrace.so contrib/plugins/libprovtrace.so
