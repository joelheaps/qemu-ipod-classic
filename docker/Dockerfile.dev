# Dev image: runs and debugs guests (QEMU runtime libs + guest/session tooling).
# The QEMU build toolchain lives in Dockerfile.build; this image has no compilers.
FROM ubuntu:26.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    gdb-multiarch binutils-arm-none-eabi python3 python3-venv python3-capstone \
    radare2 dosfstools mtools ffmpeg ca-certificates \
    libglib2.0-0t64 libgpod4t64 libpixman-1-0 libsdl2-2.0-0 libpulse0 libsndio7.0 zlib1g \
    && rm -rf /var/lib/apt/lists/*
# uv runs the PEP 723 script headers of tools/ipod_classic/*.py (dependencies fetched on first use).
# The container runs as the host uid with no writable $HOME, so keep uv's cache and managed
# installs somewhere world-writable and use the system python.
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/
ENV UV_CACHE_DIR=/tmp/uv-cache UV_PYTHON_PREFERENCE=only-system
