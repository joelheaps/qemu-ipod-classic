# Ubuntu 26.04 LTS; validated ARM64 builds and headless runtime checks.
FROM ghcr.io/jdx/mise:2026.9.12 AS mise
FROM ubuntu:26.04
COPY --from=mise /usr/local/bin/mise /usr/local/bin/mise
ENV DEBIAN_FRONTEND=noninteractive \
    MISE_DATA_DIR=/opt/mise \
    MISE_CACHE_DIR=/tmp/mise-cache \
    MISE_STATE_DIR=/tmp/mise-state \
    MISE_TRUSTED_CONFIG_PATHS=/ \
    UV_CACHE_DIR=/tmp/uv-cache \
    UV_PYTHON_INSTALL_DIR=/opt/uv-python \
    UV_PYTHON_PREFERENCE=only-managed \
    UV_PYTHON_DOWNLOADS=never
# apt build-dep needs source repositories; the stock Ubuntu image only enables binaries.
RUN sed -i 's/^Types: deb$/Types: deb deb-src/' /etc/apt/sources.list.d/ubuntu.sources \
    && apt-get update && apt-get install -y --no-install-recommends ca-certificates curl git
WORKDIR /opt/qemu-bootstrap
COPY mise.toml ./mise.toml
COPY scripts/setup ./scripts/setup
RUN mise install && UV_PYTHON_DOWNLOADS=manual mise exec -- uv python install 3.14.8
RUN mise run setup && rm -rf /var/lib/apt/lists/*
